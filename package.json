{
  "name": "@mochi-inc-japan/react-native-stylex-sheet",
  "description": "The modern CSS-in-JS library for React Native",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Tkow",
  "repository": "https://github.com/MOCHI-inc-JAPAN/react-native-stylex-sheet",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": "./lib/commonjs/index.js",
      "import": "./lib/module/index.js",
      "types": "./lib/typescript/index.d.ts"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "build": "bob build",
    "prepare": "npm run build",
    "release": "np --any-branch",
    "watch": "npm-watch",
    "test": "jest",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:write": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\""
  },
  "devDependencies": {
    "@babel/core": "7.20.7",
    "@babel/runtime": "7.20.7",
    "@changesets/cli": "^2.31.0",
    "@swc/core": "^1.15.33",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.2.5",
    "@types/node": "^18.19.130",
    "@types/react": "^19.2.14",
    "@types/react-native": "^0.70.6",
    "@typescript-eslint/eslint-plugin": "4.6.1",
    "@typescript-eslint/parser": "4.6.1",
    "babel-jest": "29.3.1",
    "eslint": "7.31.0",
    "husky": "6.0.0",
    "jest": "29.3.1",
    "metro-react-native-babel-preset": "^0.73.3",
    "npm-watch": "^0.11.0",
    "prettier": "2.3.2",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-builder-bob": "0.18.1",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.4.9",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": ">=16",
    "react-native": "*"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run format:check"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "watch": {
    "build": {
      "patterns": [
        "src"
      ],
      "extensions": "js,jsx,ts,tsx"
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  },
  "keywords": [
    "android",
    "ios",
    "react",
    "react-native",
    "native",
    "component",
    "components",
    "create",
    "css",
    "css-in-js",
    "javascript",
    "js",
    "object",
    "object-oriented",
    "oo",
    "oocss",
    "oriented",
    "style",
    "styled",
    "styles",
    "stylesheet",
    "stylesheets",
    "theme",
    "themes",
    "theming",
    "token",
    "tokens",
    "type",
    "typed",
    "types",
    "ts",
    "jsx",
    "tsx"
  ],
  "packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c"
}
