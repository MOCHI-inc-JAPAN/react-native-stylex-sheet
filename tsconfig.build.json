{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "lib/typescript",
    "emitDeclarationOnly": true,
    "rootDir": "src/internals",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/internals"],
  "exclude": ["node_modules", "example", "lib"]
}
